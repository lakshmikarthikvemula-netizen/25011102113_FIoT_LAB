# Keil generated listing files
**/Listings/

# Keil generated object and build files
**/Objects/*.obj
**/Objects/*.lst
**/Objects/*.m51
**/Objects/*.abs
**/Objects/*.omf
**/Objects/*.lnp
**/Objects/*.build_log.htm
**/Objects/*.crf
**/Objects/*.dep

# User-specific Keil settings
**/*.uvgui
**/*.uvgui.*
**/*.uvguix*
**/*.uvopt
**/*.uvoptx

# Generated intermediate build files
**/*.axf
**/*.o
**/*.d
**/*.dep
**/*.map
**/*.elf

# Generated build directories
**/Debug/
**/Release/
**/DebugConfig/
**/RTE/

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Keep .hex firmware files tracked
!**/*.hex

# Local Wi-Fi settings and audit/build scratch
**/secrets.h
**/wifi_config.h
.build/
__pycache__/

# Node-RED dependencies and local runtime state
**/Node-RED/node_modules/
**/Node-RED/.config*
**/Node-RED/.sessions*
**/Node-RED/flows_cred.json
**/Node-RED/.flows*.backup
**/Node-RED/node_modules.backup/
